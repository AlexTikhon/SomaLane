{
  "name": "@running-tracker/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test --project=chromium --project=chromium-oidc",
    "e2e:firefox": "playwright test --project=firefox-core",
    "e2e:lan-pilot": "playwright test --config=playwright.lan-pilot.config.ts",
    "e2e:portfolio-dataset": "playwright test --config=playwright.portfolio-dataset.config.ts",
    "e2e:production-build": "node ../../scripts/measure-web-bundle.mjs --out ../../.local/web-bundle/e2e-production/dist && playwright test --config=playwright.production-build.config.ts --project=production-chromium --project=production-firefox",
    "e2e:showcase": "node --import tsx support/showcase-build.ts && playwright test --config=playwright.showcase.config.ts --project=showcase-chromium --project=showcase-firefox",
    "e2e:webkit": "npm run e2e:webkit:dev-server && npm run e2e:webkit:production-build && npm run e2e:webkit:showcase",
    "e2e:webkit:dev-server": "playwright test --project=webkit-desktop --project=webkit-phone",
    "e2e:webkit:production-build": "node ../../scripts/measure-web-bundle.mjs --out ../../.local/web-bundle/e2e-production/dist && playwright test --config=playwright.production-build.config.ts --project=production-webkit",
    "e2e:webkit:showcase": "node --import tsx support/showcase-build.ts && playwright test --config=playwright.showcase.config.ts --project=showcase-webkit --project=showcase-webkit-phone",
    "e2e:smoke":"node --import tsx support/smoke-preflight.ts chromium && playwright test --config=playwright.smoke.config.ts --project=smoke-chromium",
    "e2e:smoke:firefox": "node --import tsx support/smoke-preflight.ts firefox && playwright test --config=playwright.smoke.config.ts --project=smoke-firefox",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretypecheck": "npm run build --workspace=@running-tracker/contracts"
  },
  "dependencies": {
    "@running-tracker/contracts": "0.1.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.23.1",
    "oidc-provider": "9.12.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
